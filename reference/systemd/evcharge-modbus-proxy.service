[Unit]
Description=EV Charge WT - caching Modbus/TCP proxy for the SolarEdge inverter
Documentation=file:///home/adermake/EV-CHARGER-WT-HA/docs/REGISTERS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/adermake/EV-CHARGER-WT-HA/modbus-proxy-rs/reference
ExecStart=/usr/bin/python3 /home/adermake/EV-CHARGER-WT-HA/modbus-proxy-rs/reference/muxproxy.py
Restart=always
RestartSec=5
StandardOutput=append:/home/adermake/EV-CHARGER-WT-HA/logs/muxproxy.stdout
StandardError=append:/home/adermake/EV-CHARGER-WT-HA/logs/muxproxy.stdout

[Install]
WantedBy=default.target
